# Leave unset when the frontend and backend share one domain.
# For a separate API service, use its full public API URL.
# VITE_API_URL=https://api.example.com/api

# Never enable this on the public site unless the sample inventory is intentional.
# VITE_USE_DEMO_DATA=false

# Tracking (optional). These only load after the visitor accepts that cookie category.
# Google Analytics 4 / Google Ads measurement ID, e.g. G-XXXXXXXXXX
# VITE_GA_ID=
# Meta (Facebook) Pixel ID
# VITE_META_PIXEL_ID=
